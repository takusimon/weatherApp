ar-gradient(90deg,var(--primary),var(--tertiary));\n    display:grid;\n    grid-template-columns: 15% 70% 15%;\n    grid-template-rows: 4rem auto 4rem;\n}\n\n#topbar {\n    grid-column: 2/3;\n    display: flex;\n    justify-content: space-between;\n    padding:.5rem;\n    align-items: center;\n}\n#brand {\n    display: flex;\n    gap:.5rem;\n    font-size: 1.4rem;\n    align-content: center;\n    font-weight: 800;\n}\n#brand-mark {\n    background-color: white;\n    height: min-content;\n    width: max-content;\n    border-radius: 10px;\n    filter:drop-shadow(0 0 0.2rem var(--tertiary));\n    \n}\n#brand-icon {\n    fill:var(--tertiary)\n}\n#tag-line {\n    font-family:var(--dmsans);\n    font-size: 0.8rem;\n    word-spacing:0.1rem;\n}\n\n\n#content {\n    grid-column: 2/3;\n    grid-row: 2/3;\n    margin-top: 2rem;\n    display: flex;\n    flex-flow: column;\n    gap:2rem;\n}\n\n#intro {\n    width:100%;\n    display:flex;\n    flex-flow:column nowrap;\n    align-items: center;\n    gap:.5rem;\n}\n\n#eyebrow {\n    font-family : var(--dmsans);\n    font-weight: 700;\n}\n\n#heading {\n    font-size: 3.4rem;\n    font-weight: 600;\n}\n\n#copy-intro {\n    font-weight: 400;\n}\n\n\n#search-wrap {\n    height:auto;\n    width:min-content;\n    justify-self: center;\n    align-self: center;\n    display:flex;\n    flex-flow: column;\n    gap:1rem;\n    align-items: center;\n}\n\n#search-form {\n    background-color: white;\n    padding:.5rem;\n    display: flex;\n    align-items: center;\n    border-radius: 10px;\n    gap:.2rem;\n}\n\n#search-form:user-invalid {\n    filter: drop-shadow(0 0 0.3rem red);\n}\n\n\n#search-input {\n    width:50vw;\n    height:4ch;\n    border:none;\n    font-family: var(--dmsans);\n}\n\n#search-input:focus {\n    outline:2px solid var(--tertiary);\n}\n\n#search-button {\n    height:5ch;\n    width:10ch;\n    border-radius: 10px;\n    border: none;\n    background-color: var(--tertiary);\n    font-family: var(--dmsans);\n    font-weight:600;\n    font-size: .8rem;\n    color:white;\n}\n\n#search-error {\n    align-self: center;\n    margin-top: .2rem;\n    font-family: var(--dmsans);\n    font-size:1rem;\n    font-weight: 800;\n    word-spacing:.2rem;\n    letter-spacing:.1rem;\n    color:red;\n}\n\n#si-unit-toggle:not(.visible){\n    display: none;\n}\n#si-unit-toggle {\n    border-radius: 15px;\n    border: none;\n    height:5ch;\n    width:1-ch;\n    background-color: var(--secondary);\n    color: white;\n    font-family: var(--dmsans);\n    font-weight: 800;\n}\n\n#si-unit-toggle:hover {\n    filter:drop-shadow(0 0 1rem var(--primary-offWhite));\n}\n\n#si-unit-toggle:active {\n    background-color: var(--tertiary);\n}\n\n#weather-content {\n    margin-top:1.5rem;\n    display: flex;\n    flex-flow: column nowrap;\n    align-items: center;\n    gap:1rem;\n    width:100%;\n}\n\n#hero-card {\n    display:flex;\n    width: 100%;\n    justify-content: center;\n}\n#hero-weather-img-cont {\n    width:25%;\n    background-color: var(--primary);\n    border-radius: 0 20px 20px 0;\n    padding:1.5rem;\n    display: grid;\n    align-items: center;\n    justify-items: center;\n}\n#hero-copy {\n    background-color: white;\n    width:40%;\n    height:40vh;\n    padding:3rem 3.5rem;\n    font-family: var(--dmsans);\n    font-size:.75rem;\n    font-weight: 600;\n    letter-spacing: .1rem;\n    border-radius: 20px 0 0 20px;\n}\n\n#place-row {\n    display: flex;\n    gap:.5rem;\n    color:var(--grey-text)\n}\n#location-icon {\n    fill:var(--grey-text)\n}\n\n#hero-city {\n    font-size: 2.5rem;\n    font-family: var(--manrope);\n    font-weight: 600;\n}\n\n#hero-date {\n    color:var(--grey-text)\n}\n#temperature-row {\n    display: flex;\n    align-items: center;\n    gap:1.55rem;\n}\n#temperature {\n    font-family: var(--manrope);\n    font-size: 6rem;\n    font-weight: 600;\n}\n#hero-conditions {\n    font-family: var(--dmsans);\n    font-weight: 600;\n    font-size: 1.1rem;\n}\n\n#hero-feels {\n    font-family: var(--dmsans);\n    font-weight: 400;\n    color:var(--grey-text);\n}\n\n#details-grid {\n    display: flex;\n    width:100%;\n    padding:0 18% 0 18%;\n    gap:1rem;\n}\n\n.detail-card {\n    background-color: white;\n    width:25%;\n    padding:1.125rem;\n    display:flex;\n    border-radius: 10px;\n    align-items: center;\n    gap:1rem;\n}\n\n.detail-icon {\n    height:2.5rem;\n    width:2.5rem;\n    background-color: var(--primary);\n    border-radius: 10px;\n    display:grid;\n    align-content: center;\n    justify-items: center;\n}\n\n.detail-label,.detail-note {\n    font-family: var(--dmsans);\n    font-size:.625rem;\n    color: var(--grey-text);\n    font-weight:600;\n    letter-spacing: .1rem;\n}\n\n.detail-value {\n    font-family: var(--dmsans);\n    font-size:1.025rem;\n    font-weight: 700;\n}\n\n.detail-note {\n    font-weight:400;\n    letter-spacing: normal;\n}\n@keyframes casinoLights {\n    from {\n        stroke-dashoffset:0;\n    }\n    to {\n        stroke-dashoffset:8;\n    }\n}\n\ncircle:not(.visible){\n    display:none;\n}\n.spinning.visible{\n    fill:none;\n    stroke: var(--secondary);\n    stroke-width: 12px;\n    stroke-dasharray: 3,8;\n    stroke-linecap: butt;\n    animation:\n        casinoLights 200ms linear infinite;\n}\n\nfooter {\n    grid-row:3/4;\n    grid-column: 2/3;\n    display: grid;\n    grid-auto-flow: column;\n    gap:.5rem;\n    align-content: center;\n    justify-content: center;\n}"],"sourceRoot":""}]);
