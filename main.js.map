:root {
    --primary:hsl(185, 33%, 93%);
    --primary-offWhite:hsl(189, 40%, 90%);
    --secondary:hsl(198, 41%, 47%);
    --tertiary:hsl(31.3, 91.2%, 60%);
    --grey-text:#82949C;
    --manrope:"Manrope",system-ui;
    --dmsans:"DM Sans 9pt",system-ui;

    font-family: 'Manrope','DM Sans 9pt',system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}
body {
    min-height: 100vh;
    margin:0;
    background:
    linear-gradient(90deg,var(--primary),var(--tertiary));
    display:grid;
    grid-template-columns: 15% 70% 15%;
    grid-template-rows: 4rem auto 4rem;
}

#topbar {
    grid-column: 2/3;
    display: flex;
    justify-content: space-between;
    padding:.5rem;
    align-items: center;
}
#brand {
    display: flex;
    gap:.5rem;
    font-size: 1.4rem;
    align-content: center;
    font-weight: 800;
}
#brand-mark {
    background-color: white;
    height: min-content;
    width: max-content;
    border-radius: 10px;
    filter:drop-shadow(0 0 0.2rem var(--tertiary));
    
}
#brand-icon {
    fill:var(--tertiary)
}
#tag-line {
    font-family:var(--dmsans);
    font-size: 0.8rem;
    word-spacing:0.1rem;
}


#content {
    grid-column: 2/3;
    grid-row: 2/3;
    margin-top: 2rem;
    display: flex;
    flex-flow: column;
    gap:2rem;
}

#intro {
    width:100%;
    display:flex;
    flex-flow:column nowrap;
    align-items: center;
    gap:.5rem;
}

#eyebrow {
    font-family : var(--dmsans);
    font-weight: 700;
}

#heading {
    font-size: 3.4rem;
    font-weight: 600;
}

#copy-intro {
    font-weight: 400;
}


#search-wrap {
    height:auto;
    width:min-content;
    justify-self: center;
    align-self: center;
    display:flex;
    flex-flow: column;
    gap:1rem;
    align-items: center;
}

#search-form {
    background-color: white;
    padding:.5rem;
    display: flex;
    align-items: center;
    border-radius: 10px;
    gap:.2rem;
}

#search-form:user-invalid {
    filter: drop-shadow(0 0 0.3rem red);
}


#search-input {
    width:50vw;
    height:4ch;
    border:none;
    font-family: var(--dmsans);
}

#search-input:focus {
    outline:2px solid var(--tertiary);
}

#search-button {
    height:5ch;
    width:10ch;
    border-radius: 10px;
    border: none;
    background-color: var(--tertiary);
    font-family: var(--dmsans);
    font-weight:600;
    font-size: .8rem;
    color:white;
}

#search-error {
    align-self: center;
    margin-top: .2rem;
    font-family: var(--dmsans);
    font-size:1rem;
    font-weight: 800;
    word-spacing:.2rem;
    letter-spacing:.1rem;
    color:red;
}

#si-unit-toggle:not(.visible){
    display: none;
}
#si-unit-toggle {
    border-radius: 15px;
    border: none;
    height:5ch;
    width:1-ch;
    background-color: var(--secondary);
    color: white;
    font-family: var(--dmsans);
    font-weight: 800;
}

#si-unit-toggle:hover {
    filter:drop-shadow(0 0 1rem var(--primary-offWhite));
}

#si-unit-toggle:active {
    background-color: var(--tertiary);
}

#weather-content {
    margin-top:1.5rem;
    display: flex;
    flex-flow: column nowrap;
    align-items: center;
    gap:1rem;
    width:100%;
}

#hero-card {
    display:flex;
    width: 100%;
    justify-content: center;
}
#hero-weather-img-cont {
    width:25%;
    background-color: var(--primary);
    border-radius: 0 20px 20px 0;
    padding:1.5rem;
    display: grid;
    align-items: center;
    justify-items: center;
}
#hero-copy {
    background-color: white;
    width:40%;
    height:40vh;
    padding:3rem 3.5rem;
    font-family: var(--dmsans);
    font-size:.75rem;
    font-weight: 600;
    letter-spacing: .1rem;
    border-radius: 20px 0 0 20px;
}

#place-row {
    display: flex;
    gap:.5rem;
    color:var(--grey-text)
}
#location-icon {
    fill:var(--grey-text)
}

#hero-city {
    font-size: 2.5rem;
    font-family: var(--manrope);
    font-weight: 600;
}

#hero-date {
    color:var(--grey-text)
}
#temperature-row {
    display: flex;
    align-items: center;
    gap:1.55rem;
}
#temperature {
    font-family: var(--manrope);
    font-size: 6rem;
    font-weight: 600;
}
#hero-conditions {
    font-family: var(--dmsans);
    font-weight: 600;
    font-size: 1.1rem;
}

#hero-feels {
    font-family: var(--dmsans);
    font-weight: 400;
    color:var(--grey-text);
}

#details-grid {
    display: flex;
    width:100%;
    padding:0 18% 0 18%;
    gap:1rem;
}

.detail-card {
    background-color: white;
    width:25%;
    padding:1.125rem;
    display:flex;
    border-radius: 10px;
    align-items: center;
    gap:1rem;
}

.detail-icon {
    height:2.5rem;
    width:2.5rem;
    background-color: var(--primary);
    border-radius: 10px;
    display:grid;
    align-content: center;
    justify-items: center;
}

.detail-label,.detail-note {
    font-family: var(--dmsans);
    font-size:.625rem;
    color: var(--grey-text);
    font-weight:600;
    letter-spacing: .1rem;
}

.detail-value {
    font-family: var(--dmsans);
    font-size:1.025rem;
    font-weight: 700;
}

.detail-note {
    font-weight:400;
    letter-spacing: normal;
}
@keyframes casinoLights {
    from {
        stroke-dashoffset:0;
    }
    to {
        stroke-dashoffset:8;
    }
}

circle:not(.visible){
    display:none;
}
.spinning.visible{
    fill:none;
    stroke: var(--secondary);
    stroke-width: 12px;
    stroke-dasharray: 3,8;
    stroke-linecap: butt;
    animation:
        casinoLights 200ms linear infinite;
}

footer {
    grid-row:3/4;
    grid-column: 2/3;
    display: grid;
    grid-auto-flow: column;
    gap:.5rem;
    align-content: center;
    justify-content: center;
}`, "",{"version":3,"sources":["webpack://./src/css/style.css"],"names":[],"mappings":"AAAA;IACI,0BAA0B;IAC1B;8DACyD;IACzD,mBAAmB;IACnB,kBAAkB;IAClB,kBAAkB;AACtB;;AAEA;IACI,sBAAsB;IACtB;8DAC0D;IAC1D,gBAAgB;IAChB,kBAAkB;IAClB,kBAAkB;AACtB;;;AAGA;IACI,4BAA4B;IAC5B,qCAAqC;IACrC,8BAA8B;IAC9B,gCAAgC;IAChC,mBAAmB;IACnB,6BAA6B;IAC7B,gCAAgC;;IAEhC,2KAA2K;AAC/K;AACA;IACI,iBAAiB;IACjB,QAAQ;IACR;yDACqD;IACrD,YAAY;IACZ,kCAAkC;IAClC,kCAAkC;AACtC;;AAEA;IACI,gBAAgB;IAChB,aAAa;IACb,8BAA8B;IAC9B,aAAa;IACb,mBAAmB;AACvB;AACA;IACI,aAAa;IACb,SAAS;IACT,iBAAiB;IACjB,qBAAqB;IACrB,gBAAgB;AACpB;AACA;IACI,uBAAuB;IACvB,mBAAmB;IACnB,kBAAkB;IAClB,mBAAmB;IACnB,8CAA8C;;AAElD;AACA;IACI;AACJ;AACA;IACI,yBAAyB;IACzB,iBAAiB;IACjB,mBAAmB;AACvB;;;AAGA;IACI,gBAAgB;IAChB,aAAa;IACb,gBAAgB;IAChB,aAAa;IACb,iBAAiB;IACjB,QAAQ;AACZ;;AAEA;IACI,UAAU;IACV,YAAY;IACZ,uBAAuB;IACvB,mBAAmB;IACnB,SAAS;AACb;;AAEA;IACI,2BAA2B;IAC3B,gBAAgB;AACpB;;AAEA;IACI,iBAAiB;IACjB,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;AACpB;;;AAGA;IACI,WAAW;IACX,iBAAiB;IACjB,oBAAoB;IACpB,kBAAkB;IAClB,YAAY;IACZ,iBAAiB;IACjB,QAAQ;IACR,mBAAmB;AACvB;;AAEA;IACI,uBAAuB;IACvB,aAAa;IACb,aAAa;IACb,mBAAmB;IACnB,mBAAmB;IACnB,SAAS;AACb;;AAEA;IACI,mCAAmC;AACvC;;;AAGA;IACI,UAAU;IACV,UAAU;IACV,WAAW;IACX,0BAA0B;AAC9B;;AAEA;IACI,iCAAiC;AACrC;;AAEA;IACI,UAAU;IACV,UAAU;IACV,mBAAmB;IACnB,YAAY;IACZ,iCAAiC;IACjC,0BAA0B;IAC1B,eAAe;IACf,gBAAgB;IAChB,WAAW;AACf;;AAEA;IACI,kBAAkB;IAClB,iBAAiB;IACjB,0BAA0B;IAC1B,cAAc;IACd,gBAAgB;IAChB,kBAAkB;IAClB,oBAAoB;IACpB,SAAS;AACb;;AAEA;IACI,aAAa;AACjB;AACA;IACI,mBAAmB;IACnB,YAAY;IACZ,UAAU;IACV,UAAU;IACV,kCAAkC;IAClC,YAAY;IACZ,0BAA0B;IAC1B,gBAAgB;AACpB;;AAEA;IACI,oDAAoD;AACxD;;AAEA;IACI,iCAAiC;AACrC;;AAEA;IACI,iBAAiB;IACjB,aAAa;IACb,wBAAwB;IACxB,mBAAmB;IACnB,QAAQ;IACR,UAAU;AACd;;AAEA;IACI,YAAY;IACZ,WAAW;IACX,uBAAuB;AAC3B;AACA;IACI,SAAS;IACT,gCAAgC;IAChC,4BAA4B;IAC5B,cAAc;IACd,aAAa;IACb,mBAAmB;IACnB,qBAAqB;AACzB;AACA;IACI,uBAAuB;IACvB,SAAS;IACT,WAAW;IACX,mBAAmB;IACnB,0BAA0B;IAC1B,gBAAgB;IAChB,gBAAgB;IAChB,qBAAqB;IACrB,4BAA4B;AAChC;;AAEA;IACI,aAAa;I